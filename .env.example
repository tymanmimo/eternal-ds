TOKEN=YOUR_DISCORD_BOT_TOKEN
CLIENT_ID=YOUR_APPLICATION_CLIENT_ID

# Optional HTTP/HTTPS/SOCKS proxy used for YouTube extraction and streaming.
YOUTUBE_PROXY=

# Keep the yt-dlp binary current automatically.
YOUTUBE_DL_AUTO_UPDATE=true

# Number of attempts to resolve each YouTube stream (1-10).
YOUTUBE_STREAM_RETRIES=3
