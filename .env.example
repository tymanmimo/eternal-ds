TOKEN=YOUR_DISCORD_BOT_TOKEN
CLIENT_ID=YOUR_APPLICATION_CLIENT_ID

# Optional HTTP/HTTPS/SOCKS proxy used for YouTube extraction and streaming.
YOUTUBE_PROXY=

# Keep the yt-dlp binary current automatically.
YOUTUBE_DL_AUTO_UPDATE=true

# Attempts for YouTube stream startup and playlist metadata resolution (1-5).
YOUTUBE_STREAM_RETRIES=2

# Audio buffered before FFmpeg starts reading (16-1024 KiB).
YOUTUBE_PREBUFFER_KB=128

# Per-attempt and total stream startup deadlines in milliseconds.
YOUTUBE_STARTUP_TIMEOUT_MS=12000
YOUTUBE_TOTAL_TIMEOUT_MS=25000

# Maximum time for one YouTube playlist metadata attempt.
YOUTUBE_PLAYLIST_TIMEOUT_MS=30000

# Log command, resolver, and stream startup timings.
PERFORMANCE_LOGGING=true
