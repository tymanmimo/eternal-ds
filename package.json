{
    "name": "eternal-ds",
    "version": "1.0.0",
    "private": true,
    "description": "A self-hosted Discord music bot built with TypeScript, discord.js, and discord-player.",
    "main": "dist/index.js",
    "scripts": {
        "dev": "nodemon src/index.ts",
        "deploy": "ts-node src/deploy.ts",
        "build": "tsc",
        "start": "node dist/index.js"
    },
    "keywords": [
        "discord",
        "discord-bot",
        "discord-player",
        "music-bot",
        "typescript"
    ],
    "author": "tymanmimo",
    "license": "ISC",
    "type": "commonjs",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/tymanmimo/eternal-ds.git"
    },
    "bugs": {
        "url": "https://github.com/tymanmimo/eternal-ds/issues"
    },
    "homepage": "https://github.com/tymanmimo/eternal-ds#readme",
    "engines": {
        "node": ">=22.19.0"
    },
    "devDependencies": {
        "@types/node": "~22.19.0",
        "nodemon": "^3.1.14",
        "ts-node": "^10.9.2",
        "typescript": "^5.9.3"
    },
    "dependencies": {
        "@discord-player/extractor": "^7.2.0",
        "@snazzah/davey": "^0.1.12",
        "discord-player": "^7.2.0",
        "discord-player-youtubei": "^3.0.0-beta.4",
        "discord.js": "^14.27.0",
        "dotenv": "^17.4.2",
        "ffmpeg-static": "^5.3.0",
        "mediaplex": "^1.0.0",
        "youtube-dl-exec": "3.1.9"
    },
    "allowScripts": {
        "ffmpeg-static@5.3.0": true,
        "esbuild": false,
        "youtube-dl-exec@3.1.9": true
    }
}
