{
    "name": "eternal-ds",
    "version": "1.0.0",
    "private": true,
    "description": "A self-hosted Discord music bot built with TypeScript, discord.js, and discord-player.",
    "main": "dist/index.js",
    "scripts": {
        "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
        "dev": "nodemon src/index.ts",
        "deploy": "ts-node src/deploy.ts",
        "typecheck:src": "tsc --noEmit",
        "typecheck:test": "tsc --project tsconfig.test.json",
        "typecheck": "npm run typecheck:src && npm run typecheck:test",
        "build": "npm run clean && tsc",
        "start": "node dist/index.js",
        "test": "npm run build && npm run typecheck:test && node --test --test-concurrency=1 \"test/**/*.test.ts\"",
        "test:coverage": "npm run build && npm run typecheck:test && node --test --test-concurrency=1 --experimental-test-coverage --test-coverage-include=\"dist/**/*.js\" --test-coverage-exclude=\"dist/index.js\" --test-coverage-exclude=\"dist/deploy.js\" --test-coverage-lines=80 --test-coverage-functions=80 --test-coverage-branches=75 \"test/**/*.test.ts\""
    },
    "keywords": [
        "discord",
        "discord-bot",
        "discord-player",
        "music-bot",
        "typescript"
    ],
    "author": "tymanmimo",
    "license": "MIT",
    "type": "commonjs",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/tymanmimo/eternal-ds.git"
    },
    "bugs": {
        "url": "https://github.com/tymanmimo/eternal-ds/issues"
    },
    "homepage": "https://github.com/tymanmimo/eternal-ds#readme",
    "engines": {
        "node": ">=22.19.0"
    },
    "devDependencies": {
        "@types/node": "~22.19.0",
        "nodemon": "^3.1.14",
        "ts-node": "^10.9.2",
        "typescript": "^5.9.3"
    },
    "dependencies": {
        "@discord-player/extractor": "^7.2.0",
        "@snazzah/davey": "^0.1.12",
        "discord-player": "^7.2.0",
        "discord-player-youtubei": "^3.0.0-beta.4",
        "discord.js": "^14.27.0",
        "dotenv": "^17.4.2",
        "ffmpeg-static": "^5.3.0",
        "mediaplex": "^1.0.0",
        "youtube-dl-exec": "3.1.9"
    },
    "allowScripts": {
        "ffmpeg-static@5.3.0": true,
        "esbuild": false,
        "youtube-dl-exec@3.1.9": true
    }
}
